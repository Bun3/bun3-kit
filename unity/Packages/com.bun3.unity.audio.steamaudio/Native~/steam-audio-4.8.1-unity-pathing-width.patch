+// Mid/side width with a 20 ms linear slew toward target. Width 1 leaves samples untouched.
+void bun3ApplyPathingWidth(float* left, float* right, int frames, float& current, float target, int sampleRate)
+{
+    float step = 1.0f / std::max(1.0f, sampleRate * 0.02f);
+    for (int i = 0; i < frames; ++i)
+    {
+        if (current < target)
+            current = std::min(target, current + step);
+        else if (current > target)
+            current = std::max(target, current - step);
+        if (current == 1.0f)
+            continue;
+        float mid = (left[i] + right[i]) * 0.5f;
+        float side = (left[i] - right[i]) * (0.5f * current);
+        left[i] = mid + side;
+        right[i] = mid - side;
+    }
+}
+
