    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bun3.Server.GameplayTags</RootNamespace>
    <PackageId>Bun3.Server.GameplayTags</PackageId>
