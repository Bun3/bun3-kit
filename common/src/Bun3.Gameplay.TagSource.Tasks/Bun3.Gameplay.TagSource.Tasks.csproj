<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Bun3.Gameplay.TagSource.Tasks</RootNamespace>
    <AssemblyName>Bun3.Gameplay.TagSource.Tasks</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.8.0]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="[17.8.3]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="[17.8.3]" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.2]" PrivateAssets="all" />
  </ItemGroup>

</Project>
