<Project>

  <PropertyGroup>
    <Bun3GameplayTagTasksAssembly Condition="'$(Bun3GameplayTagTasksAssembly)' == ''">$(MSBuildThisFileDirectory)Bun3.Gameplay.TagSource.Tasks.dll</Bun3GameplayTagTasksAssembly>
    <TargetsForTfmSpecificContentInPackage Condition="'$(Bun3GameplayTagSource)' == 'true'">$(TargetsForTfmSpecificContentInPackage);ExtractBun3NativeGameplayTags</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <UsingTask TaskName="Bun3.Gameplay.TagSource.Tasks.ExtractNativeGameplayTagsTask"
             AssemblyFile="$(Bun3GameplayTagTasksAssembly)" />

  <Target Name="ExtractBun3NativeGameplayTags"
          DependsOnTargets="Build;ResolveReferences"
          Condition="'$(Bun3GameplayTagSource)' == 'true'">
    <PropertyGroup>
      <Bun3GameplayTagMetadataOutput Condition="'$(Bun3GameplayTagMetadataOutput)' == ''">$(IntermediateOutputPath)Bun3\GameplayTags\TagSource.json</Bun3GameplayTagMetadataOutput>
    </PropertyGroup>
    <ExtractNativeGameplayTagsTask Sources="@(Compile)"
                                   References="@(ReferencePath)"
                                   TargetPath="$(TargetPath)"
                                   OutputPath="$(Bun3GameplayTagMetadataOutput)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(Bun3GameplayTagMetadataOutput)">
        <PackagePath>contentFiles/any/any/Bun3/GameplayTags/TagSource.json</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
