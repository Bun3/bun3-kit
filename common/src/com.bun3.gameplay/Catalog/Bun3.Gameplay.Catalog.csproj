<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Bun3.Gameplay.Tags.Catalog</RootNamespace>
    <!-- Assembly name matches the Unity asmdef (Bun3.Gameplay.Catalog); only the PackageId marks this as authoring-time. -->
    <AssemblyName>Bun3.Gameplay.Catalog</AssemblyName>
    <PackageId>Bun3.Gameplay.Authoring</PackageId>
    <Version>0.1.0</Version>
    <Authors>Bun3</Authors>
    <Description>GameplayTag authoring tools — Source compiler, B3DK writer, legacy JSON loader. Not needed at runtime.</Description>
    <RepositoryUrl>https://github.com/Bun3/bun3-kit</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bun3.Gameplay.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.2]" />
  </ItemGroup>

</Project>
